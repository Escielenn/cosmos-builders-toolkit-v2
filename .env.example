# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Get these from: Supabase Dashboard > Project Settings > API
#
# Your Supabase project URL
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Your Supabase anon/public key (safe to expose in browser)
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"

# Project ID (optional, for reference)
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# ===========================================
# STRIPE CONFIGURATION (Optional - for subscriptions)
# ===========================================
# Get your publishable key from: Stripe Dashboard > Developers > API Keys
# Use test keys (pk_test_...) for development
#
# VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
#
# Note: The secret key and webhook secret are configured in Supabase Edge Functions,
# not in this file. See supabase/functions/ for Edge Function configuration.

# ===========================================
# SENTRY CONFIGURATION (Optional - for error monitoring)
# ===========================================
# Public DSN for the @sentry/react browser SDK. Get from:
#   Sentry Dashboard > Settings > Projects > [your project] > Client Keys (DSN)
#
# When unset, src/lib/sentry.ts skips init() entirely and every Sentry call
# becomes a no-op. Safe for local dev and contributor clones.
#
# VITE_SENTRY_DSN="https://[KEY]@[ORG].ingest.sentry.io/[PROJECT-ID]"
