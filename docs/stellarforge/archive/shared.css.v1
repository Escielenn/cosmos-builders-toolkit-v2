/* ══════════════════════════════════════════════════════════════════════════
 * StellarForge — shared.css · REVISION 1 · SUPERSEDED · DO NOT USE
 *
 * Preserved verbatim for reference only. Every value below that is marked
 * FAILED was measured against WCAG on 2026-08-16 and did not clear its target.
 * The replacement is design/tokens.css, which is GENERATED by
 * design/derive.py — see archive/README.md for the full v1 → v2 token map.
 * ══════════════════════════════════════════════════════════════════════════ */

@font-face {
  font-family: 'MD Nichrome';
  src: url('assets/fonts/MDNichrome-Light.woff2') format('woff2');
  font-weight: 300; font-display: swap;
}
@font-face {
  font-family: 'MD Nichrome';
  src: url('assets/fonts/MDNichrome-Regular.woff2') format('woff2');
  font-weight: 400; font-display: swap;
}

:root {
  /* Backgrounds — planes separated at 1.04:1 and 1.09:1. FAILED. */
  --sf-void: #0A0E17;               /* kept in v2 — this is the brand */
  --sf-surface: #0E1320;            /* FAILED  → v2 #1B2334 */
  --sf-surface-elevated: #161C2B;   /* FAILED  → v2 #273249 */
  --sf-surface-80: rgba(14, 19, 32, 0.9);  /* removed in v2 — alpha over the
                                              starfield made a panel's actual
                                              colour frame-dependent */

  /* Borders — the single worst defect in the system. */
  --sf-border: rgba(255, 255, 255, 0.08);        /* 1.20:1  FAILED (needs 3.0) */
  --sf-border-strong: rgba(255, 255, 255, 0.14); /* 1.45:1  FAILED (needs 3.0) */

  /* Accents — all eleven hues survive unchanged in v2, each gaining a
     lifted `-text` stop for body-size text. */
  --sf-teal: #15C17B;
  --sf-teal-bright: #3DFFCD;
  --sf-cyan: #00D4FF;
  --sf-amber: #FFB800;
  --sf-amber-warm: #FFB347;
  --sf-stellar: #5B8DEF;      /* v2 adds --sf-stellar-text #6698FC */
  --sf-emerald: #00FF88;
  --sf-violet: #9B5DE5;       /* v2 adds --sf-violet-text  #BA7DFF */
  --sf-crimson: #FF3366;      /* v2 adds --sf-crimson-text #FF658B */
  --sf-azure: #4D9FFF;
  --sf-magenta: #FF00AA;      /* v2 adds --sf-magenta-text #FF54D4 */

  /* Text tiers — only ever verified against the void, which is why they
     collapsed on elevated surfaces. */
  --t1: #FAFAFA;                      /* kept */
  --t2: #C8C8C8;                      /* → v2 #C9CDD3 */
  --t3: rgba(255, 255, 255, 0.45);    /* 4.43:1 on elevated  MARGINAL FAIL */
  --t4: rgba(255, 255, 255, 0.28);    /* 2.45:1  FAILED */
  --t5: rgba(255, 255, 255, 0.15);    /* 1.51:1  RETIRED in v2 */

  --font-display: 'MD Nichrome', 'Space Grotesk', sans-serif;
  --font-heading: 'Jura', 'DM Sans', sans-serif;
  --font-sans: 'DM Sans', system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, monospace;

  --tr-title: 0.08em;   /* → v2 0.06em */
  --tr-wide:  0.2em;    /* → v2 0.12em — tracking under 12px destroys word shape */
  --tr-ultra: 0.4em;    /* → v2 0.24em, 24px+ only */
}

html, body {
  margin: 0;
  background: var(--sf-void);
  color: var(--t2);
  font-family: var(--font-sans);
  font-weight: 400;
  line-height: 1.55;              /* → v2 1.6 at 16px */
  -webkit-font-smoothing: antialiased;
}

/* ── Prototype primitives ────────────────────────────────────────────────
   Superseded by components/Button.tsx, Panel.tsx, Field.tsx. */

.sf-h1 { font-family: var(--font-display); font-weight: 300;
         letter-spacing: var(--tr-title); color: var(--t1); text-transform: uppercase; }

.sf-eyebrow { font-family: var(--font-heading); font-weight: 500; font-size: 11px;
              letter-spacing: var(--tr-wide); text-transform: uppercase;
              color: var(--t3); }
              /* 11px + 0.2em + low contrast: the least readable element in v1.
                 → v2 text-sf-eyebrow, 12px / 0.12em / 600 / t4 at 4.50:1 */

.sf-label { font-family: var(--font-sans); font-weight: 500; font-size: 11px;
            letter-spacing: 1.5px; text-transform: uppercase; color: var(--t3); }

.sf-mono { font-family: var(--font-mono); font-weight: 400; letter-spacing: 0.02em; }

.sf-section { font-family: var(--font-heading); font-weight: 300; font-size: 20px;
              letter-spacing: 2px; text-transform: uppercase; color: var(--t1); }

.sf-panel { background: var(--sf-surface-80); border: 1px solid var(--sf-border);
            border-radius: 0; backdrop-filter: blur(16px); position: relative; }

.sf-panel--glow::before { content: ''; position: absolute; bottom: 0; left: 10%; right: 10%;
  height: 1px; pointer-events: none;
  background: linear-gradient(to right, transparent, rgba(61,255,205,0.25), transparent); }

.sf-bracket { position: relative; }
.sf-bracket::before, .sf-bracket::after { content: ''; position: absolute;
  width: 12px; height: 12px; border: 1px solid var(--sf-teal); }
.sf-bracket::before { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
.sf-bracket::after  { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }

.sf-btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px;
  font-family: var(--font-sans); font-weight: 500; font-size: 13px;
  letter-spacing: 1.2px; text-transform: uppercase; border-radius: 0;
  border: 1px solid var(--sf-teal); background: var(--sf-teal); color: #08110C;
  cursor: pointer; text-decoration: none; transition: all 180ms ease; }
  /* ~38px tall — below the 44px target. No focus state defined anywhere. */
.sf-btn:hover { box-shadow: 0 0 24px rgba(61,255,205,0.3); transform: translateY(-1px); }
.sf-btn--ghost { background: transparent; color: var(--t1);
                 border-color: var(--sf-border-strong); }
  /* label 18.5:1, boundary 1.45:1 — the button that didn't look like a button */
.sf-btn--ghost:hover { border-color: var(--sf-teal); color: var(--sf-teal-bright);
                       box-shadow: inset 0 0 20px rgba(61,255,205,0.08); }

.sf-tag { display: inline-block; padding: 3px 8px; font-family: var(--font-mono);
  font-size: 10px; letter-spacing: 1.2px; text-transform: uppercase;
  background: rgba(21,193,123,0.06); border: 1px solid rgba(21,193,123,0.22);
  color: var(--sf-teal); border-radius: 2px; }
.sf-tag--amber   { background: rgba(255,184,0,0.06);  border-color: rgba(255,184,0,0.25);  color: var(--sf-amber); }
.sf-tag--azure   { background: rgba(77,159,255,0.06); border-color: rgba(77,159,255,0.25); color: var(--sf-azure); }
.sf-tag--violet  { background: rgba(155,93,229,0.06); border-color: rgba(155,93,229,0.25); color: var(--sf-violet); }
.sf-tag--emerald { background: rgba(0,255,136,0.06);  border-color: rgba(0,255,136,0.25);  color: var(--sf-emerald); }
.sf-tag--stellar { background: rgba(91,141,239,0.06); border-color: rgba(91,141,239,0.25); color: var(--sf-stellar); }
.sf-tag--crimson { background: rgba(255,51,102,0.06); border-color: rgba(255,51,102,0.25); color: var(--sf-crimson); }
  /* 10px tag text in a canonical accent — v2 uses 12px and the -text stop */

.sf-divider { height: 1px; margin: 32px 0;
  background: linear-gradient(to right, transparent, var(--sf-border-strong), transparent); }

/* Starfield + grain — v2 gates both on var(--sf-ambient) */
.starfield { position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background:
    radial-gradient(1px 1px at 20% 30%, rgba(255,255,255,0.4), transparent 50%),
    radial-gradient(1px 1px at 40% 70%, rgba(255,255,255,0.3), transparent 50%),
    radial-gradient(1.5px 1.5px at 60% 20%, rgba(91,141,239,0.4), transparent 50%),
    radial-gradient(1px 1px at 80% 50%, rgba(255,255,255,0.3), transparent 50%),
    radial-gradient(1px 1px at 10% 80%, rgba(255,255,255,0.35), transparent 50%),
    radial-gradient(1px 1px at 90% 85%, rgba(21,193,123,0.4), transparent 50%),
    radial-gradient(1px 1px at 50% 95%, rgba(255,255,255,0.25), transparent 50%),
    radial-gradient(1px 1px at 30% 15%, rgba(255,255,255,0.25), transparent 50%),
    radial-gradient(1px 1px at 70% 40%, rgba(255,255,255,0.3), transparent 50%),
    radial-gradient(1px 1px at 15% 55%, rgba(255,255,255,0.3), transparent 50%);
  background-size: 800px 600px; }

.grain::before { content: ''; position: fixed; inset: 0; pointer-events: none;
  opacity: 0.03; z-index: 1;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E"); }

/* Scrollbars — thumb #2E3548 on #0A0E17 measures 1.40:1. FAILED. */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: var(--sf-void); }
::-webkit-scrollbar-thumb { background: var(--sf-surface-elevated); border: 2px solid var(--sf-void); }
::-webkit-scrollbar-thumb:hover { background: #25304a; }

.sf-sb { scrollbar-color: #2E3548 #0A0E17; scrollbar-width: thin; }
.sf-sb::-webkit-scrollbar { width: 8px; height: 8px; }
.sf-sb::-webkit-scrollbar-track { background: #0A0E17; border: 0; }
.sf-sb::-webkit-scrollbar-thumb { background: #2E3548; border: 0; border-radius: 0; }
.sf-sb::-webkit-scrollbar-thumb:hover { background: #3D4658; }
.sf-sb::-webkit-scrollbar-corner { background: #0A0E17; }
.sf-sb--slim::-webkit-scrollbar { width: 6px; height: 6px; }
.sf-sb--slim { scrollbar-width: thin; }

/* REMOVED in v2 — a scrollbar that hides for 800ms fails WCAG 1.4.11 for
   exactly as long as the user spends hunting for it. */
.sf-sb--idle::-webkit-scrollbar-thumb { background: transparent;
  transition: background 300ms ease 800ms; }
.sf-sb--idle:hover::-webkit-scrollbar-thumb,
.sf-sb--idle.is-scrolling::-webkit-scrollbar-thumb { background: #2E3548; transition-delay: 0ms; }

/* Style-guide-only helpers */
.sg-do   { background: rgba(21,193,123,0.04); border: 1px solid rgba(21,193,123,0.35); padding: 18px 20px; }
.sg-dont { background: rgba(255,51,102,0.04); border: 1px solid rgba(255,51,102,0.35); padding: 18px 20px; }
.sg-dont-label { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; color: var(--sf-crimson); }
